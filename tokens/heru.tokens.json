{
  "$description": "Herú design tokens (W3C DTCG). One primitive: unit = 4px. Everything else is unit multiples or density-driven. No color tokens yet.",
  "unit": {
    "$type": "dimension",
    "$value": "4px",
    "$description": "The only primitive. Emitted as 0.25rem so it scales with user font size."
  },
  "density": {
    "$type": "number",
    "$description": "Unit-count multipliers that change per density mode. Select a mode with data-heru-density on any element; default also applies on :root.",
    "$extensions": {
      "heru.modes": ["compact", "default", "comfortable"]
    },
    "leading-units": {
      "$value": 5,
      "$description": "Body line height in units.",
      "$extensions": {
        "heru.modes": {
          "compact": 4,
          "default": 5,
          "comfortable": 6
        }
      }
    },
    "pad-units": {
      "$value": 2,
      "$description": "Control block padding in units (each side).",
      "$extensions": {
        "heru.modes": {
          "compact": 1,
          "default": 2,
          "comfortable": 3
        }
      }
    },
    "pad-inline-units": {
      "$value": 3,
      "$description": "Control inline padding in units (each side).",
      "$extensions": {
        "heru.modes": {
          "compact": 2,
          "default": 3,
          "comfortable": 4
        }
      }
    },
    "control-sm-units": {
      "$value": 8,
      "$description": "Small control height in units (6/8/10 → 24/32/40px). Set directly so compact sm stays at the 24px WCAG 2.2 target size.",
      "$extensions": {
        "heru.modes": {
          "compact": 6,
          "default": 8,
          "comfortable": 10
        }
      }
    }
  },
  "space": {
    "0": {
      "$value": "0"
    },
    "1": {
      "$value": "{unit} * 1"
    },
    "2": {
      "$value": "{unit} * 2"
    },
    "3": {
      "$value": "{unit} * 3"
    },
    "4": {
      "$value": "{unit} * 4"
    },
    "5": {
      "$value": "{unit} * 5"
    },
    "6": {
      "$value": "{unit} * 6"
    },
    "8": {
      "$value": "{unit} * 8"
    },
    "10": {
      "$value": "{unit} * 10"
    },
    "12": {
      "$value": "{unit} * 12"
    },
    "16": {
      "$value": "{unit} * 16"
    },
    "$type": "dimension",
    "$description": "Page and layout spacing. space-N = N × unit (N × 4px). Fixed across density modes."
  },
  "radius": {
    "$type": "dimension",
    "$description": "Corner radius, odd-pixel ramp. radius-N = N px. Exempt from the 4px grid. Controls use radius-5.",
    "none": {
      "$value": "0"
    },
    "1": {
      "$value": "1px"
    },
    "3": {
      "$value": "3px"
    },
    "5": {
      "$value": "5px"
    },
    "7": {
      "$value": "7px"
    },
    "9": {
      "$value": "9px"
    },
    "11": {
      "$value": "11px"
    },
    "full": {
      "$value": "9999px",
      "$description": "Pill/circle."
    }
  },
  "border": {
    "$type": "dimension",
    "$description": "Border widths. Borders are drawn inside control heights (box-sizing: border-box).",
    "width": {
      "$value": "1px",
      "$description": "Intentionally off-grid."
    }
  },
  "leading": {
    "$type": "dimension",
    "$description": "Density-driven line height used for control text and to derive control heights.",
    "body": {
      "$value": "{unit} * {density.leading-units}"
    }
  },
  "control": {
    "$type": "dimension",
    "$description": "Interactive control sizing. md = leading.body + pad × 2; lg uses one more pad unit; sm is a per-mode unit count (6/8/10) so it never drops below 24px.",
    "height": {
      "sm": {
        "$value": "{unit} * {density.control-sm-units}"
      },
      "md": {
        "$value": "{leading.body} + {unit} * {density.pad-units} * 2"
      },
      "lg": {
        "$value": "{leading.body} + {unit} * ({density.pad-units} + 1) * 2"
      }
    },
    "padding-inline": {
      "$value": "{unit} * {density.pad-inline-units}"
    },
    "padding-block": {
      "$value": "{unit} * {density.pad-units}"
    }
  },
  "font": {
    "$description": "Typography primitives.",
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["Inter", "ui-sans-serif", "system-ui", "sans-serif"]
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "monospace"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "size": {
      "12": {
        "$value": "{unit} * 3"
      },
      "14": {
        "$value": "{unit} * 3.5"
      },
      "16": {
        "$value": "{unit} * 4"
      },
      "18": {
        "$value": "{unit} * 4.5"
      },
      "20": {
        "$value": "{unit} * 5"
      },
      "24": {
        "$value": "{unit} * 6"
      },
      "28": {
        "$value": "{unit} * 7"
      },
      "$type": "dimension",
      "$description": "Font sizes named by their px value at the default 16px root. font-size-N = N px."
    },
    "line-height": {
      "16": {
        "$value": "{unit} * 4"
      },
      "20": {
        "$value": "{unit} * 5"
      },
      "24": {
        "$value": "{unit} * 6"
      },
      "28": {
        "$value": "{unit} * 7"
      },
      "32": {
        "$value": "{unit} * 8"
      },
      "36": {
        "$value": "{unit} * 9"
      },
      "$type": "dimension",
      "$description": "Line heights named by px value; every one is a multiple of 4px. line-height-N = N px."
    }
  },
  "text": {
    "$description": "Semantic text roles. Each role = size + line-height + weight (+ family). Use these in components; use the numeric scales only when no role fits.",
    "caption": {
      "font-size": {
        "$value": "{font.size.12}"
      },
      "line-height": {
        "$value": "{font.line-height.16}"
      },
      "font-weight": {
        "$value": "{font.weight.regular}"
      },
      "font-family": {
        "$value": "{font.family.sans}"
      }
    },
    "label": {
      "font-size": {
        "$value": "{font.size.14}"
      },
      "line-height": {
        "$value": "{font.line-height.20}"
      },
      "font-weight": {
        "$value": "{font.weight.medium}"
      },
      "font-family": {
        "$value": "{font.family.sans}"
      }
    },
    "body": {
      "font-size": {
        "$value": "{font.size.14}"
      },
      "line-height": {
        "$value": "{font.line-height.20}"
      },
      "font-weight": {
        "$value": "{font.weight.regular}"
      },
      "font-family": {
        "$value": "{font.family.sans}"
      }
    },
    "body-lg": {
      "font-size": {
        "$value": "{font.size.16}"
      },
      "line-height": {
        "$value": "{font.line-height.24}"
      },
      "font-weight": {
        "$value": "{font.weight.regular}"
      },
      "font-family": {
        "$value": "{font.family.sans}"
      }
    },
    "heading-3": {
      "font-size": {
        "$value": "{font.size.18}"
      },
      "line-height": {
        "$value": "{font.line-height.28}"
      },
      "font-weight": {
        "$value": "{font.weight.semibold}"
      },
      "font-family": {
        "$value": "{font.family.sans}"
      }
    },
    "heading-2": {
      "font-size": {
        "$value": "{font.size.20}"
      },
      "line-height": {
        "$value": "{font.line-height.28}"
      },
      "font-weight": {
        "$value": "{font.weight.semibold}"
      },
      "font-family": {
        "$value": "{font.family.sans}"
      }
    },
    "heading-1": {
      "font-size": {
        "$value": "{font.size.28}"
      },
      "line-height": {
        "$value": "{font.line-height.36}"
      },
      "font-weight": {
        "$value": "{font.weight.bold}"
      },
      "font-family": {
        "$value": "{font.family.sans}"
      }
    },
    "code": {
      "font-size": {
        "$value": "{font.size.14}"
      },
      "line-height": {
        "$value": "{font.line-height.20}"
      },
      "font-weight": {
        "$value": "{font.weight.regular}"
      },
      "font-family": {
        "$value": "{font.family.mono}"
      }
    }
  },
  "color": {
    "$type": "color",
    "$description": "Minimal palette in OKLCH: one dark slate ramp and one error red. Use the semantic names (color-bg, color-text, …), not the ramps.",
    "slate": {
      "$description": "Dark slate ramp (hue 260, low chroma). The only non-error ramp. 0 = white, 950 = near-black with a blue tint.",
      "0": {
        "$value": "oklch(1 0 0)"
      },
      "50": {
        "$value": "oklch(0.984 0.003 260)"
      },
      "100": {
        "$value": "oklch(0.968 0.007 260)"
      },
      "200": {
        "$value": "oklch(0.929 0.013 260)"
      },
      "300": {
        "$value": "oklch(0.869 0.02 260)"
      },
      "400": {
        "$value": "oklch(0.704 0.03 260)"
      },
      "500": {
        "$value": "oklch(0.554 0.035 260)"
      },
      "600": {
        "$value": "oklch(0.446 0.035 260)"
      },
      "700": {
        "$value": "oklch(0.372 0.035 260)"
      },
      "800": {
        "$value": "oklch(0.279 0.033 260)"
      },
      "900": {
        "$value": "oklch(0.208 0.03 260)"
      },
      "950": {
        "$value": "oklch(0.129 0.03 260)"
      }
    },
    "red": {
      "$description": "Error ramp (hue 27). 50 subtle fill, 600 borders/icons, 700 text.",
      "50": {
        "$value": "oklch(0.971 0.013 27)"
      },
      "600": {
        "$value": "oklch(0.56 0.19 27)"
      },
      "700": {
        "$value": "oklch(0.48 0.17 27)"
      }
    },
    "bg": {
      "$value": "{color.slate.0}",
      "$description": "Page background."
    },
    "surface": {
      "$value": "{color.slate.50}",
      "$description": "Raised or inset surface (cards, wells)."
    },
    "text": {
      "$value": "{color.slate.900}",
      "$description": "Primary text."
    },
    "text-muted": {
      "$value": "{color.slate.600}",
      "$description": "Secondary text: descriptions, placeholders. AA on bg and surface."
    },
    "border": {
      "$value": "{color.slate.300}",
      "$description": "Default control/divider border (decorative)."
    },
    "border-strong": {
      "$value": "{color.slate.500}",
      "$description": "Border that must be visible (hover, inputs needing 3:1)."
    },
    "accent": {
      "$value": "{color.slate.950}",
      "$description": "Primary action fill: near-black slate."
    },
    "accent-hover": {
      "$value": "{color.slate.800}",
      "$description": "Primary action fill on hover: one step lighter."
    },
    "accent-active": {
      "$value": "{color.slate.900}",
      "$description": "Primary action fill while pressed/active."
    },
    "on-accent": {
      "$value": "{color.slate.0}",
      "$description": "Text/icons on accent fills."
    },
    "focus-ring": {
      "$value": "{color.slate.600}",
      "$description": "Focus ring. ≥3:1 on bg."
    },
    "error": {
      "$value": "{color.red.600}",
      "$description": "Error borders and icons."
    },
    "error-text": {
      "$value": "{color.red.700}",
      "$description": "Error message text. AA on bg."
    },
    "error-surface": {
      "$value": "{color.red.50}",
      "$description": "Muted red background for the attached field status (error) box."
    }
  },
  "focus": {
    "$description": "Focus indicator that grows in: ring-offset gap in color-bg, a ring-width ring (ring-blur edge) in color-focus-ring, then a halo-width halo. Total extent = offset + width + halo (8px); field gaps use space-3 (12px) for ≥2px clearance.",
    "ring-width": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "Ring thickness."
    },
    "ring-offset": {
      "$type": "dimension",
      "$value": "2px"
    },
    "ring-blur": {
      "$type": "dimension",
      "$value": "0.5px",
      "$description": "Slight softening of the ring edge."
    },
    "halo-width": {
      "$type": "dimension",
      "$value": "3px",
      "$description": "Soft halo band visible past the ring's outer edge."
    },
    "halo": {
      "$type": "color",
      "$value": "oklch(0.554 0.035 260 / 0.12)",
      "$description": "Halo color: slate-500 at 12%."
    }
  },
  "motion": {
    "$description": "Motion. Respect prefers-reduced-motion.",
    "duration-fast": {
      "$type": "duration",
      "$value": "160ms"
    },
    "ease-out": {
      "$type": "cubicBezier",
      "$value": [0.2, 0, 0, 1]
    },
    "duration-medium": {
      "$type": "duration",
      "$value": "200ms",
      "$description": "Popup slide-down and error reveal."
    }
  },
  "elevation": {
    "$type": "shadow",
    "$description": "Shared elevation foundation (NAME PENDING — Technical Writer). Three semantic levels usable by any raised surface: popovers, menus, dialogs, field status. Built from slate-950 (hue 260) in OKLCH; urgent is tinted from error red (hue 27). Literal CSS box-shadow values.",
    "default": {
      "$value": "0 1px 2px oklch(0.129 0.03 260 / 0.06), 0 4px 12px -2px oklch(0.129 0.03 260 / 0.12)",
      "$description": "Resting raised surface: open menu, popover."
    },
    "hover": {
      "$value": "0 1px 2px oklch(0.129 0.03 260 / 0.08), 0 2px 6px -1px oklch(0.129 0.03 260 / 0.16)",
      "$description": "Interactive item on hover/press (lifts within a raised surface)."
    },
    "urgent": {
      "$value": "0 1px 2px oklch(0.56 0.19 27 / 0.12), 0 4px 12px -2px oklch(0.56 0.19 27 / 0.24)",
      "$description": "Error-urgent: attached error/status box. Tinted from red-600."
    }
  }
}
